class Solution {
    public boolean halvesAreAlike(String s) {
        String vowels = "aeiouAEIOU";
        int n = s.length();
        int count = 0;
        
        // Count vowels in the first half
        for (int i = 0; i < n / 2; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count++;
            }
        }
        
        // Subtract vowels found in the second half
        for (int i = n / 2; i < n; i++) {
            if (vowels.indexOf(s.charAt(i)) != -1) {
                count--;
            }
        }
        
        // If counts match, the net count will be 0
        return count == 0;
    }
}
